set -eu
unset QORE_TREESITTER_QUERY_DIR QORE_MODULE_DIR QORE_MODULE_DIR_ONLY QORE_INCLUDE_DIR LD_LIBRARY_PATH LD_PRELOAD
cd "$AUTOPKGTEST_TMP"
cat > treesitter-smoke.q <<'EOF'
%modern
%requires treesitter
TreeSitterParser parser(language: "python");
TreeSitterTree tree = parser.parse(source: "answer = 42\n");
if (tree.getRootNode().hasError() || tree.getRootNode().getType() != "module") {
    throw "PACKAGE-TEST-ERROR", "Installed parser failed";
}
TreeSitterQuery query("python", TreeSitterParser::getHighlightQuery(language: "python"));
if (query.getCaptureCount() == 0) {
    throw "PACKAGE-TEST-ERROR", "Installed query files are unavailable";
}
EOF
/usr/bin/qcc -o treesitter-smoke treesitter-smoke.q
./treesitter-smoke
