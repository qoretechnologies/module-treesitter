#include "treesitter-module.h"
#include "TreeSitterParser.h"
#include "TreeSitterTree.h"

//! The TreeSitterParser class wraps a tree-sitter parser for a specific language
/** The TreeSitterParser class provides source code parsing functionality using the tree-sitter library.

    @par Example:
    @code{.py}
%new-style
%require-types
%strict-args

%requires treesitter

TreeSitterParser parser("python");
TreeSitterTree tree = parser.parse("def hello(): pass");
TreeSitterNode root = tree.getRootNode();
printf("Root type: %s\n", root.getType());
    @endcode

    @par Thread Safety
    This class is thread-safe; all methods can be called from any thread.

    @since treesitter 1.0
*/
qclass TreeSitterParser [arg=TreeSitterParser* parser; ns=TreeSitter; vparent=Qore::Serializable];

//! Creates a new TreeSitterParser for the given language
/** @param language the language to parse (e.g., "python", "java", "json", "yaml", "javascript", "kotlin", "typescript", "tsx", "sql", "markdown", "qore")

    @throw TREESITTER-LANGUAGE-ERROR if the language is not supported

    @par Example:
    @code{.py}
TreeSitterParser parser("python");
    @endcode
*/
TreeSitterParser::constructor(string language) {
    ReferenceHolder<TreeSitterParser> holder(new TreeSitterParser(language->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    if (!holder->isValid()) {
        return;
    }
    self->setPrivate(CID_TREESITTERPARSER, holder.release());
}

//! Destroys the parser
/**
*/
TreeSitterParser::destructor() {
    parser->deref(xsink);
}

//! Returns a copy of the parser
/**
*/
TreeSitterParser::copy() {
    // Create a new parser for the same language
    ReferenceHolder<TreeSitterParser> holder(
        new TreeSitterParser(parser->getLanguageName().c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    self->setPrivate(CID_TREESITTERPARSER, holder.release());
}

//! Parse source code and return the syntax tree
/** @param source the source code to parse

    @return a TreeSitterTree object representing the parsed syntax tree

    @throw TREESITTER-PARSE-ERROR if parsing fails

    @par Example:
    @code{.py}
TreeSitterParser parser("python");
TreeSitterTree tree = parser.parse("def foo(): return 42");
    @endcode
*/
TreeSitterTree TreeSitterParser::parse(string source) {
    TreeSitterTree* tree = parser->parse(source, xsink);
    if (*xsink || !tree) {
        return QoreValue();
    }
    return new QoreObject(QC_TREESITTERTREE, getProgram(), tree);
}

//! Parse source code incrementally using a previous tree
/** @param source the new source code
    @param old_tree the previous parse tree to reuse for incremental parsing

    @return a new TreeSitterTree object

    @throw TREESITTER-PARSE-ERROR if parsing fails

    This method is more efficient than parse() when making small edits to the source code,
    as it can reuse parts of the old tree that haven't changed.

    @par Example:
    @code{.py}
TreeSitterParser parser("python");
TreeSitterTree tree1 = parser.parse("def foo(): return 42");
# Edit the tree to reflect source changes
tree1.edit(0, 3, 3, 0, 0, 0, 3, 0, 3);
TreeSitterTree tree2 = parser.parseIncremental("def bar(): return 42", tree1);
    @endcode
*/
TreeSitterTree TreeSitterParser::parseIncremental(string source, TreeSitterTree[TreeSitterTree] old_tree) {
    TreeSitterTree* tree = parser->parseIncremental(source, *old_tree, xsink);
    if (*xsink || !tree) {
        return QoreValue();
    }
    return new QoreObject(QC_TREESITTERTREE, getProgram(), tree);
}

//! Get the language name for this parser
/** @return the language name (e.g., "python", "java")
*/
string TreeSitterParser::getLanguage() {
    return new QoreStringNode(parser->getLanguageName());
}

//! Set the parse timeout in microseconds
/** @param timeout_micros the timeout in microseconds (0 = no timeout)

    If parsing takes longer than the timeout, the parser will stop and return
    a partial tree or raise an error.
*/
nothing TreeSitterParser::setTimeout(int timeout_micros) {
    parser->setTimeout(timeout_micros);
}

//! Get the current timeout in microseconds
/** @return the timeout in microseconds (0 = no timeout)
*/
int TreeSitterParser::getTimeout() {
    return parser->getTimeout();
}

//! Get the list of supported languages
/** @return a list of language names that can be used to create parsers

    @par Example:
    @code{.py}
list<string> langs = TreeSitterParser::getSupportedLanguages();
# Returns: ("python", "java", "json", "yaml", "javascript", "kotlin", "typescript", "tsx", "qore")
    @endcode
*/
static list<string> TreeSitterParser::getSupportedLanguages() {
    return TreeSitterLanguages::getLanguageList();
}

//! Check if a language is supported
/** @param language the language name to check

    @return True if the language is supported, False otherwise
*/
static bool TreeSitterParser::isLanguageSupported(string language) {
    return TreeSitterLanguages::isLanguageSupported(language->c_str());
}

//! Get the bundled upstream highlight query for a language
/** Returns the contents of the upstream \c highlights.scm query file shipped with the
    grammar.  The result is cached after the first call for each language.

    Supported language names: \c "python", \c "java", \c "json", \c "yaml",
    \c "javascript" (alias: \c "js"), \c "kotlin" (alias: \c "kt"),
    \c "typescript" (alias: \c "ts"), \c "tsx".

    @param language the language name or alias

    @return the contents of the upstream highlights.scm query file for the given language

    @throw TREESITTER-QUERY-ERROR if the language is not supported or the query file cannot be read

    @par Example: Retrieve and use an upstream highlight query
    @code{.py}
%new-style
%require-types
%strict-args

%requires treesitter

# Get the bundled upstream highlight query for Python
string query_text = TreeSitterParser::getHighlightQuery("python");

# Create a query object and run it against parsed source
TreeSitterParser parser("python");
TreeSitterTree tree = parser.parse("def hello(): pass");
TreeSitterQuery query("python", query_text);
list<hash<auto>> captures = query.captures(tree.getRootNode());
foreach hash<auto> cap in (captures) {
    printf("%s: %s (bytes %d-%d)\n", cap.name, cap.node.text,
        cap.node.start_byte, cap.node.end_byte);
}
    @endcode

    @par Example: Use an alias
    @code{.py}
# "js" is an alias for "javascript"
string js_query = TreeSitterParser::getHighlightQuery("js");
    @endcode

    @since treesitter 1.0
*/
static string TreeSitterParser::getHighlightQuery(string language) {
    return TreeSitterLanguages::getHighlightQuery(language->c_str(), xsink);
}

//! Get a bundled query file for a language by query type
/** Returns the contents of the specified query file shipped with the grammar.
    The result is cached after the first call for each language/type combination.

    Common query types:
    - \c "highlights": syntax highlighting patterns
    - \c "locals": local scope and variable tracking
    - \c "injections": embedded language regions
    - \c "tags": symbol tagging for code navigation
    - \c "folds": foldable code regions
    - \c "indents": indentation rules

    @param language the language name or alias
    @param query_type the query type (e.g., "highlights", "locals", "injections", "folds", "indents")

    @return the contents of the query file

    @throw TREESITTER-QUERY-ERROR if the language is not supported or the query file cannot be found

    @par Example:
    @code{.py}
# Get the locals query for better variable scope highlighting
string locals_query = TreeSitterParser::getQuery("javascript", "locals");

# Get injection queries for multi-language documents
string injections = TreeSitterParser::getQuery("javascript", "injections");
    @endcode

    @since treesitter 1.0
*/
static string TreeSitterParser::getQuery(string language, string query_type) [flags=RET_VALUE_ONLY] {
    return TreeSitterLanguages::getQuery(language->c_str(), query_type->c_str(), xsink);
}

//! Set the ranges of text the parser should include when parsing
/** This enables multi-language document support. When included ranges are set,
    the parser will only process the text within the specified ranges, treating
    the rest as if it were whitespace.

    @param ranges a list of range hashes, each with keys:
    - \c start_byte: the start byte offset
    - \c end_byte: the end byte offset
    - \c start_row: the start row (0-indexed)
    - \c start_column: the start column (0-indexed)
    - \c end_row: the end row (0-indexed)
    - \c end_column: the end column (0-indexed)

    @return True on success

    @throw TREESITTER-PARSER-ERROR if the parser is not valid

    @par Example: Parse embedded JavaScript in HTML
    @code{.py}
# Parse HTML to find <script> regions
TreeSitterParser html_parser("javascript");
# ... find script regions ...

# Parse only the JavaScript portions
TreeSitterParser js_parser("javascript");
list<hash<auto>> ranges = (
    {"start_byte": 50, "end_byte": 120, "start_row": 3, "start_column": 0,
     "end_row": 8, "end_column": 0},
);
js_parser.setIncludedRanges(ranges);
TreeSitterTree js_tree = js_parser.parse(full_html_source);
    @endcode

    @since treesitter 1.0
*/
bool TreeSitterParser::setIncludedRanges(list<hash<auto>> ranges) {
    size_t count = ranges->size();
    if (count == 0) {
        // Reset to full document
        return parser->setIncludedRanges(nullptr, 0, xsink);
    }
    std::vector<TSRange> ts_ranges(count);
    ConstListIterator it(ranges);
    size_t i = 0;
    while (it.next()) {
        const QoreHashNode* h = it.getValue().get<QoreHashNode>();
        TSRange& r = ts_ranges[i];
        r.start_byte = (uint32_t)h->getKeyValue("start_byte").getAsBigInt();
        r.end_byte = (uint32_t)h->getKeyValue("end_byte").getAsBigInt();
        r.start_point.row = (uint32_t)h->getKeyValue("start_row").getAsBigInt();
        r.start_point.column = (uint32_t)h->getKeyValue("start_column").getAsBigInt();
        r.end_point.row = (uint32_t)h->getKeyValue("end_row").getAsBigInt();
        r.end_point.column = (uint32_t)h->getKeyValue("end_column").getAsBigInt();
        ++i;
    }
    return parser->setIncludedRanges(ts_ranges.data(), count, xsink);
}
