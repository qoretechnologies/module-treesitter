#include "treesitter-module.h"
#include "TreeSitterQuery.h"
#include "TreeSitterNode.h"

//! The TreeSitterQuery class provides pattern matching on syntax trees
/** The TreeSitterQuery class provides pattern matching on syntax trees.
    Queries use S-expression patterns to match nodes in the tree.

    @par Example:
    @code{.py}
# Find all function definitions and their names
TreeSitterQuery query("python", "(function_definition name: (identifier) @func_name) @func");
list<hash<auto>> matches = query.execute(root);
foreach hash<auto> match in (matches) {
    foreach hash<auto> capture in (match.captures) {
        printf("Capture '%s': type=%s\n", capture.name, capture.node.type);
    }
}
    @endcode

    @par Query Syntax
    @code{.txt}
(node_type) matches a node of that type
(node_type field: (child_type)) matches a node with a specific field
@capture_name captures the matched node with a name
(node_type (child_type)+) matches one or more children
(node_type (child_type)?) matches zero or one child
(node_type (child_type)*) matches zero or more children
(node_type (#eq? @capture "text")) matches nodes with specific text
    @endcode

    @since treesitter 1.0
*/
qclass TreeSitterQuery [arg=TreeSitterQuery* query; ns=TreeSitter; vparent=Qore::Serializable];

//! Create a query for the given language
/** @param language the language name (e.g., "python", "java")
    @param pattern the S-expression query pattern

    @throw TREESITTER-LANGUAGE-ERROR if the language is not supported
    @throw TREESITTER-QUERY-ERROR if the query pattern is invalid

    @par Example:
    @code{.py}
# Query to find all string literals
TreeSitterQuery query("python", "(string) @str");

# Query to find all function calls
TreeSitterQuery query("python", "(call function: (identifier) @func_name) @call");

# Query to find all imports
TreeSitterQuery query("python", "(import_statement) @import");
    @endcode
*/
TreeSitterQuery::constructor(string language, string pattern) {
    ReferenceHolder<TreeSitterQuery> holder(
        new TreeSitterQuery(language->c_str(), pattern->c_str(), xsink), xsink);
    if (*xsink) {
        return;
    }
    if (!holder->isValid()) {
        return;
    }
    self->setPrivate(CID_TREESITTERQUERY, holder.release());
}

//! Destroys the query
/**
*/
TreeSitterQuery::destructor() {
    query->deref(xsink);
}

//! Returns a copy of the query
/**
*/
TreeSitterQuery::copy() {
    xsink->raiseException("TREESITTERQUERY-COPY-ERROR",
        "TreeSitterQuery objects cannot be copied; create a new query instead");
}

//! Execute the query on a node and return all matches
/** @param node the node to search (usually the root node)

    @return a list of match hashes, each containing:
    - \c pattern_index: the index of the matched pattern
    - \c captures: a list of capture hashes with:
      - \c name: the capture name (without @)
      - \c node: a hash with node information (type, positions, text)

    The node hash contains: \c type, \c start_byte, \c end_byte, \c start_row,
    \c start_column, \c end_row, \c end_column, and \c text.

    @note Query predicates (\c \#eq?, \c \#not-eq?, \c \#match?, \c \#not-match?,
    \c \#any-of?, \c \#not-any-of?) are automatically evaluated and matches that
    fail predicates are filtered out.

    @par Example:
    @code{.py}
TreeSitterQuery query("python", "(function_definition name: (identifier) @name) @func");
list<hash<auto>> matches = query.execute(root);

foreach hash<auto> match in (matches) {
    printf("Pattern %d matched:\n", match.pattern_index);
    foreach hash<auto> capture in (match.captures) {
        printf("  %s: %s at byte %d\n", capture.name, capture.node.type, capture.node.start_byte);
    }
}
    @endcode
*/
list<hash<auto>> TreeSitterQuery::execute(TreeSitterNode[TreeSitterNode] node) {
    return query->execute(*node, xsink, nullptr);
}

//! Execute the query and return all captures in order
/** @param node the node to search

    @return a list of capture hashes, each containing:
    - \c name: the capture name
    - \c pattern_index: which pattern this capture came from
    - \c node: a hash with node information (type, positions, text)

    The node hash contains: \c type, \c start_byte, \c end_byte, \c start_row,
    \c start_column, \c end_row, \c end_column, and \c text.

    Unlike execute(), this method returns captures in the order they appear
    in the source, which is useful for syntax highlighting.

    @note Query predicates (\c \#eq?, \c \#not-eq?, \c \#match?, \c \#not-match?,
    \c \#any-of?, \c \#not-any-of?) are automatically evaluated and captures from
    matches that fail predicates are filtered out.

    @par Example:
    @code{.py}
# Syntax highlighting query with multiple patterns
string highlight_query = "
    (string) @string
    (number) @number
    (identifier) @variable
    (function_definition name: (identifier) @function)
    (comment) @comment
";
TreeSitterQuery query("python", highlight_query);
list<hash<auto>> captures = query.captures(root);

foreach hash<auto> cap in (captures) {
    printf("Highlight %s at bytes %d-%d\n",
           cap.name, cap.node.start_byte, cap.node.end_byte);
}
    @endcode
*/
list<hash<auto>> TreeSitterQuery::captures(TreeSitterNode[TreeSitterNode] node) {
    return query->captures(*node, xsink, nullptr);
}

//! Get the number of patterns in the query
/** @return the pattern count
*/
int TreeSitterQuery::getPatternCount() {
    return query->getPatternCount();
}

//! Get the number of capture names in the query
/** @return the capture count
*/
int TreeSitterQuery::getCaptureCount() {
    return query->getCaptureCount();
}

//! Get a capture name by index
/** @param index the capture index

    @return the capture name (without @)
*/
*string TreeSitterQuery::getCaptureName(int index) {
    const char* name = query->getCaptureName(index);
    if (!name) {
        return QoreValue();
    }
    return new QoreStringNode(name);
}

//! Disable a capture by name
/** @param name the capture name to disable (without @)

    Disabled captures will not be included in query results.
*/
nothing TreeSitterQuery::disableCapture(string name) {
    query->disableCapture(name->c_str());
}

//! Disable a pattern by index
/** @param pattern_index the pattern index to disable

    Disabled patterns will not be matched during query execution.
*/
nothing TreeSitterQuery::disablePattern(int pattern_index) {
    query->disablePattern(pattern_index);
}

//! Set the byte range for query execution
/** @param start_byte the start byte offset (inclusive)
    @param end_byte the end byte offset (exclusive)

    Restricts query execution to only match nodes that intersect the given byte range.
    This is essential for performance on large files: only query the visible viewport
    instead of the entire document.

    @par Example:
    @code{.py}
# Only highlight lines in the visible viewport
TreeSitterQuery query("python", highlight_pattern);
query.setByteRange(viewport_start_byte, viewport_end_byte);
list<hash<auto>> captures = query.captures(root);
    @endcode

    @see clearByteRange()
*/
nothing TreeSitterQuery::setByteRange(int start_byte, int end_byte) {
    query->setByteRange(start_byte, end_byte);
}

//! Set the point range for query execution
/** @param start_row the start row (0-indexed, inclusive)
    @param start_column the start column (0-indexed, inclusive)
    @param end_row the end row (0-indexed, exclusive)
    @param end_column the end column (0-indexed, exclusive)

    Restricts query execution to only match nodes that intersect the given
    row/column range.

    @see clearPointRange()
*/
nothing TreeSitterQuery::setPointRange(int start_row, int start_column,
                                        int end_row, int end_column) {
    TSPoint start = {static_cast<uint32_t>(start_row), static_cast<uint32_t>(start_column)};
    TSPoint end = {static_cast<uint32_t>(end_row), static_cast<uint32_t>(end_column)};
    query->setPointRange(start, end);
}

//! Clear the byte range restriction
/** Removes any byte range previously set with setByteRange(), so subsequent
    queries will match the entire document.
*/
nothing TreeSitterQuery::clearByteRange() {
    query->clearByteRange();
}

//! Clear the point range restriction
/** Removes any point range previously set with setPointRange(), so subsequent
    queries will match the entire document.
*/
nothing TreeSitterQuery::clearPointRange() {
    query->clearPointRange();
}

//! Set the maximum start depth for query execution
/** @param max_depth the maximum depth from the root node at which patterns can start
    matching (0 = only root, 1 = root's direct children, etc.)

    Limits query matching to nodes at most \a max_depth levels deep. This is useful
    for extracting top-level definitions (e.g., symbol outlines) without matching
    deeply nested constructs.

    @par Example:
    @code{.py}
# Get only top-level function definitions (not nested ones)
TreeSitterQuery query("python", "(function_definition name: (identifier) @name) @func");
query.setMaxStartDepth(2);  # module -> function_definition
list<hash<auto>> captures = query.captures(root);
    @endcode
*/
nothing TreeSitterQuery::setMaxStartDepth(int max_depth) {
    query->setMaxStartDepth(max_depth);
}

//! Execute the query with metadata for \c \#is?/\#is-not? directive evaluation
/** @param node the node to search
    @param metadata a hash of directive metadata from a prior query run (e.g., from resolveLocals())

    The metadata hash maps property names (e.g., "local") to lists of node byte ranges
    where that property is true. When a query pattern contains \c \#is? or \c \#is-not?,
    the captured node's byte range is looked up in the metadata to determine if the
    predicate passes.

    @return a list of match hashes (same format as execute())

    @par Example:
    @code{.py}
# Resolve local variables first
hash<auto> metadata = TreeSitterQuery::resolveLocals("javascript", root);
# Run highlights query with local variable awareness
list<hash<auto>> matches = query.execute(root, metadata);
    @endcode
*/
list<hash<auto>> TreeSitterQuery::execute(TreeSitterNode[TreeSitterNode] node, *hash<auto> metadata) {
    return query->execute(*node, xsink, metadata);
}

//! Execute the query and return captures with metadata for directive evaluation
/** @param node the node to search
    @param metadata a hash of directive metadata from a prior query run

    @return a list of capture hashes (same format as captures())
*/
list<hash<auto>> TreeSitterQuery::captures(TreeSitterNode[TreeSitterNode] node, *hash<auto> metadata) {
    return query->captures(*node, xsink, metadata);
}

//! Resolve local variable scopes for a language and return metadata
/** Runs the \c locals.scm query for the given language to identify local scopes,
    definitions, and references. Returns a metadata hash suitable for passing to
    execute() or captures() to enable \c \#is?/\#is-not? directive evaluation.

    @param language the language name
    @param node the root node to analyze

    @return a metadata hash with a "local" key containing byte ranges of local variable references

    @throw TREESITTER-LANGUAGE-ERROR if the language is not supported
    @throw TREESITTER-QUERY-ERROR if the locals query cannot be loaded or parsed

    @par Example:
    @code{.py}
TreeSitterParser parser("javascript");
TreeSitterTree tree = parser.parse(source);
TreeSitterNode root = tree.getRootNode();

# Resolve locals and use for highlighting
hash<auto> metadata = TreeSitterQuery::resolveLocals("javascript", root);
string hl_src = TreeSitterParser::getHighlightQuery("javascript");
TreeSitterQuery query("javascript", hl_src);
list<hash<auto>> captures = query.captures(root, metadata);
    @endcode

    @since treesitter 1.0
*/
static *hash<auto> TreeSitterQuery::resolveLocals(string language, TreeSitterNode[TreeSitterNode] node) [flags=RET_VALUE_ONLY] {
    QoreHashNode* result = TreeSitterQuery::resolveLocals(language->c_str(), *node, xsink);
    if (!result) {
        return QoreValue();
    }
    return result;
}
