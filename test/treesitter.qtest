#!/usr/bin/env qore
# -*- mode: qore; indent-tabs-mode: nil -*-

%modern

%requires QUnit
%requires treesitter

%exec-class TreeSitterTest

#! Comprehensive tests for the treesitter module
class TreeSitterTest inherits QUnit::Test {
    constructor() : QUnit::Test("TreeSitterTest", "1.0", \ARGV) {
        # Parser tests
        addTestCase("Parser creation", \testParserCreation());
        addTestCase("Parser invalid language", \testParserInvalidLanguage());
        addTestCase("Parser timeout", \testParserTimeout());
        addTestCase("Supported languages", \testSupportedLanguages());
        addTestCase("Parser included ranges", \testParserIncludedRanges());

        # Basic parsing tests
        addTestCase("Parse Python", \testParsePython());
        addTestCase("Parse Java", \testParseJava());
        addTestCase("Parse JSON", \testParseJSON());
        addTestCase("Parse YAML", \testParseYAML());
        addTestCase("Parse JavaScript", \testParseJavaScript());
        addTestCase("Parse Kotlin", \testParseKotlin());
        addTestCase("Parse TypeScript", \testParseTypeScript());
        addTestCase("Parse TSX", \testParseTsx());
        addTestCase("Parse SQL", \testParseSQL());
        addTestCase("Parse Markdown", \testParseMarkdown());

        # Tree tests
        addTestCase("Tree root node", \testTreeRootNode());
        addTestCase("Tree source", \testTreeSource());
        addTestCase("Tree copy", \testTreeCopy());
        addTestCase("Tree edit", \testTreeEdit());
        addTestCase("Tree changed ranges", \testTreeChangedRanges());

        # Node tests
        addTestCase("Node type", \testNodeType());
        addTestCase("Node positions", \testNodePositions());
        addTestCase("Node text", \testNodeText());
        addTestCase("Node children", \testNodeChildren());
        addTestCase("Node named children", \testNodeNamedChildren());
        addTestCase("Node child by field", \testNodeChildByField());
        addTestCase("Node parent", \testNodeParent());
        addTestCase("Node siblings", \testNodeSiblings());
        addTestCase("Node properties", \testNodeProperties());
        addTestCase("Node isError", \testNodeIsError());
        addTestCase("Node hasChanges", \testNodeHasChanges());
        addTestCase("Node field name for child", \testNodeFieldNameForChild());
        addTestCase("Node toHash", \testNodeToHash());
        addTestCase("Node toSexp", \testNodeToSexp());
        addTestCase("Node descendant by range", \testNodeDescendantByRange());
        addTestCase("Node equality", \testNodeEquality());

        # Cursor tests
        addTestCase("Cursor navigation", \testCursorNavigation());
        addTestCase("Cursor field name", \testCursorFieldName());
        addTestCase("Cursor depth", \testCursorDepth());
        addTestCase("Cursor copy", \testCursorCopy());
        addTestCase("Cursor goto for byte", \testCursorGotoForByte());

        # Query tests
        addTestCase("Query basic", \testQueryBasic());
        addTestCase("Query captures", \testQueryCaptures());
        addTestCase("Query multiple patterns", \testQueryMultiplePatterns());
        addTestCase("Query invalid pattern", \testQueryInvalidPattern());
        addTestCase("Query disable capture", \testQueryDisableCapture());
        addTestCase("Query capture text", \testQueryCaptureText());
        addTestCase("Query byte range", \testQueryByteRange());
        addTestCase("Query point range", \testQueryPointRange());
        addTestCase("Query max start depth", \testQueryMaxStartDepth());
        addTestCase("Query predicate eq", \testQueryPredicateEq());
        addTestCase("Query predicate not-eq", \testQueryPredicateNotEq());
        addTestCase("Query predicate match", \testQueryPredicateMatch());
        addTestCase("Query predicate not-match", \testQueryPredicateNotMatch());
        addTestCase("Query predicate any-of", \testQueryPredicateAnyOf());
        addTestCase("Query predicate not-any-of", \testQueryPredicateNotAnyOf());

        # Incremental parsing tests
        addTestCase("Incremental parsing", \testIncrementalParsing());

        # Error handling tests
        addTestCase("Parse with errors", \testParseWithErrors());
        addTestCase("Missing nodes", \testMissingNodes());

        # Highlight query tests
        addTestCase("Highlight query valid languages", \testHighlightQueryValidLanguages());
        addTestCase("Highlight query aliases", \testHighlightQueryAliases());
        addTestCase("Highlight query invalid language", \testHighlightQueryInvalid());
        addTestCase("Highlight query creates valid query", \testHighlightQueryParseable());
        addTestCase("Highlight query caching", \testHighlightQueryCaching());
        addTestCase("Generalized query API", \testGeneralizedQueryAPI());
        addTestCase("SQL highlight query", \testSQLHighlightQuery());
        addTestCase("Markdown highlight query", \testMarkdownHighlightQuery());

        # Edge cases and corner cases
        addTestCase("Empty source", \testEmptySource());
        addTestCase("Unicode source", \testUnicodeSource());
        addTestCase("Large source", \testLargeSource());
        addTestCase("Deeply nested", \testDeeplyNested());

        set_return_value(main());
    }

    # Parser tests
    testParserCreation() {
        TreeSitterParser parser("python");
        assertEq("python", parser.getLanguage());
    }

    testParserInvalidLanguage() {
        assertThrows("TREESITTER-LANGUAGE-ERROR", sub() {
            TreeSitterParser parser("nonexistent_language");
        });
    }

    testParserTimeout() {
        TreeSitterParser parser("python");
        parser.setTimeout(1000000);  # 1 second
        assertEq(1000000, parser.getTimeout());
        parser.setTimeout(0);
        assertEq(0, parser.getTimeout());
    }

    testSupportedLanguages() {
        list<string> langs = TreeSitterParser::getSupportedLanguages();
        assertTrue(langs.size() >= 11);
        assertTrue(TreeSitterParser::isLanguageSupported("python"));
        assertTrue(TreeSitterParser::isLanguageSupported("java"));
        assertTrue(TreeSitterParser::isLanguageSupported("json"));
        assertTrue(TreeSitterParser::isLanguageSupported("yaml"));
        assertTrue(TreeSitterParser::isLanguageSupported("javascript"));
        assertTrue(TreeSitterParser::isLanguageSupported("kotlin"));
        assertTrue(TreeSitterParser::isLanguageSupported("typescript"));
        assertTrue(TreeSitterParser::isLanguageSupported("tsx"));
        assertTrue(TreeSitterParser::isLanguageSupported("sql"));
        assertTrue(TreeSitterParser::isLanguageSupported("markdown"));
        assertTrue(TreeSitterParser::isLanguageSupported("md"));
        assertTrue(TreeSitterParser::isLanguageSupported("qore"));
        assertFalse(TreeSitterParser::isLanguageSupported("nonexistent"));
    }

    testParserIncludedRanges() {
        # Test that setIncludedRanges limits parsing to specified ranges
        TreeSitterParser parser("python");
        string source = "XXXXXX x = 1 XXXXXX";
        # Parse only the "x = 1" portion (bytes 7-12)
        list<hash<auto>> ranges = (
            {
                "start_byte": 7, "end_byte": 12,
                "start_row": 0, "start_column": 7,
                "end_row": 0, "end_column": 12,
            },
        );
        assertTrue(parser.setIncludedRanges(ranges));
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();
        assertEq("module", root.getType());
        # The parsed region should have meaningful content
        assertTrue(root.getNamedChildCount() > 0);

        # Reset to full document
        assertTrue(parser.setIncludedRanges(()));
    }

    # Basic parsing tests
    testParsePython() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def hello(): pass");
        assertEq("module", tree.getRootNode().getType());
    }

    testParseJava() {
        TreeSitterParser parser("java");
        TreeSitterTree tree = parser.parse("class Test { }");
        assertEq("program", tree.getRootNode().getType());
    }

    testParseJSON() {
        TreeSitterParser parser("json");
        TreeSitterTree tree = parser.parse('{"key": "value"}');
        assertEq("document", tree.getRootNode().getType());
    }

    testParseYAML() {
        TreeSitterParser parser("yaml");
        TreeSitterTree tree = parser.parse("key: value");
        assertEq("stream", tree.getRootNode().getType());
    }

    testParseJavaScript() {
        TreeSitterParser parser("javascript");
        TreeSitterTree tree = parser.parse("function test() { return 42; }");
        assertEq("program", tree.getRootNode().getType());
    }

    testParseKotlin() {
        TreeSitterParser parser("kotlin");
        TreeSitterTree tree = parser.parse("fun main() { println(\"Hello\") }");
        TreeSitterNode root = tree.getRootNode();
        assertEq("source_file", root.getType());
    }

    testParseTypeScript() {
        TreeSitterParser parser("typescript");
        TreeSitterTree tree = parser.parse("function greet(name: string): string { return \"Hello \" + name; }");
        TreeSitterNode root = tree.getRootNode();
        assertEq("program", root.getType());
    }

    testParseTsx() {
        TreeSitterParser parser("tsx");
        TreeSitterTree tree = parser.parse("const App = (): JSX.Element => <div>Hello</div>;");
        TreeSitterNode root = tree.getRootNode();
        assertEq("program", root.getType());
    }

    testParseSQL() {
        TreeSitterParser parser("sql");
        TreeSitterTree tree = parser.parse("SELECT id, name FROM users WHERE id = 1");
        TreeSitterNode root = tree.getRootNode();
        assertTrue(exists root);
        assertFalse(root.hasError());
    }

    testParseMarkdown() {
        TreeSitterParser parser("markdown");
        TreeSitterTree tree = parser.parse("# Hello\n\nThis is a paragraph.\n\n- item 1\n- item 2");
        TreeSitterNode root = tree.getRootNode();
        assertTrue(exists root);
        assertFalse(root.hasError());
    }

    # Tree tests
    testTreeRootNode() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        assertEq("module", root.getType());
        assertTrue(root.isNamed());
        assertTrue(exists root);
    }

    testTreeSource() {
        TreeSitterParser parser("python");
        string source = "x = 1";
        TreeSitterTree tree = parser.parse(source);
        assertEq(source, tree.getSource());
    }

    testTreeCopy() {
        TreeSitterParser parser("python");
        TreeSitterTree tree1 = parser.parse("x = 1");
        TreeSitterTree tree2 = tree1.copy();
        assertEq(tree1.getRootNode().getType(), tree2.getRootNode().getType());
    }

    testTreeEdit() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        # Edit from "x = 1" to "y = 1"
        tree.edit(0, 1, 1, 0, 0, 0, 1, 0, 1);
        # After edit, tree structure should still be accessible
        assertTrue(exists tree.getRootNode());
    }

    testTreeChangedRanges() {
        TreeSitterParser parser("python");
        TreeSitterTree tree1 = parser.parse("x = 1");
        tree1.edit(0, 1, 1, 0, 0, 0, 1, 0, 1);
        TreeSitterTree tree2 = parser.parseIncremental("y = 1", tree1);
        list<hash<auto>> ranges = tree1.getChangedRanges(tree2);
        assertTrue(ranges.size() >= 0);  # May or may not have changes depending on tree-sitter version
    }

    # Node tests
    testNodeType() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass");
        TreeSitterNode root = tree.getRootNode();
        assertEq("module", root.getType());
        TreeSitterNode func = root.getNamedChild(0);
        assertEq("function_definition", func.getType());
    }

    testNodePositions() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        assertEq(0, root.getStartByte());
        assertEq(5, root.getEndByte());

        hash<auto> start = root.getStartPoint();
        assertEq(0, start.row);
        assertEq(0, start.column);
    }

    testNodeText() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 42");
        TreeSitterNode root = tree.getRootNode();
        # Find the integer literal
        TreeSitterNode expr = root.getNamedChild(0);  # expression_statement
        TreeSitterNode assign = expr.getNamedChild(0);  # assignment
        assertEq("x = 42", root.getText());
    }

    testNodeChildren() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        assertTrue(root.getChildCount() > 0);
        list<TreeSitterNode> children = root.getChildren();
        assertTrue(children.size() > 0);
    }

    testNodeNamedChildren() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1\ny = 2");
        TreeSitterNode root = tree.getRootNode();
        assertEq(2, root.getNamedChildCount());
        list<TreeSitterNode> named = root.getNamedChildren();
        assertEq(2, named.size());
    }

    testNodeChildByField() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(x): pass");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterNode func = root.getNamedChild(0);
        *TreeSitterNode name = func.getChildByFieldName("name");
        assertTrue(exists name);
        assertEq("identifier", name.getType());
        assertEq("foo", name.getText());
    }

    testNodeParent() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterNode child = root.getNamedChild(0);
        *TreeSitterNode parent = child.getParent();
        assertTrue(exists parent);
        assertEq("module", parent.getType());
    }

    testNodeSiblings() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1\ny = 2");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterNode first = root.getNamedChild(0);
        *TreeSitterNode next = first.getNextNamedSibling();
        assertTrue(exists next);
        *TreeSitterNode prev = next.getPrevNamedSibling();
        assertTrue(exists prev);
    }

    testNodeProperties() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass");
        TreeSitterNode root = tree.getRootNode();
        assertTrue(root.isNamed());
        assertFalse(root.isMissing());
        assertFalse(root.hasError());
    }

    testNodeIsError() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def (");
        TreeSitterNode root = tree.getRootNode();
        assertTrue(root.hasError());

        # Walk to find an ERROR node
        bool found_error = False;
        TreeSitterCursor cursor = root.getCursor();
        cursor.gotoFirstChild();
        do {
            TreeSitterNode node = cursor.getCurrentNode();
            if (node.isError()) {
                found_error = True;
                break;
            }
            # Check children
            if (cursor.gotoFirstChild()) {
                do {
                    if (cursor.getCurrentNode().isError()) {
                        found_error = True;
                        break;
                    }
                } while (cursor.gotoNextSibling());
                if (found_error) {
                    break;
                }
                cursor.gotoParent();
            }
        } while (cursor.gotoNextSibling());
        assertTrue(found_error, "should find an ERROR node in broken syntax");

        # Normal code should not have error nodes
        TreeSitterTree good_tree = parser.parse("x = 1");
        assertFalse(good_tree.getRootNode().isError());
    }

    testNodeHasChanges() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        # Before edit, root should not have changes
        assertFalse(tree.getRootNode().hasChanges());

        # After edit, root should have changes
        tree.edit(4, 5, 5, 0, 4, 0, 5, 0, 5);
        assertTrue(tree.getRootNode().hasChanges());
    }

    testNodeFieldNameForChild() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(x): pass");
        TreeSitterNode func = tree.getRootNode().getNamedChild(0);
        assertEq("function_definition", func.getType());

        # getFieldNameForNamedChild: first named child should be "name"
        *string field0 = func.getFieldNameForNamedChild(0);
        assertEq("name", field0);

        # Find the "body" field
        bool found_body = False;
        for (int i = 0; i < func.getNamedChildCount(); i++) {
            *string field = func.getFieldNameForNamedChild(i);
            if (field == "body") {
                found_body = True;
                break;
            }
        }
        assertTrue(found_body, "should find 'body' field in function_definition");

        # getFieldNameForChild: some children (like keywords) have no field name
        # The "def" keyword is the first child (anonymous), should return NOTHING
        *string kw_field = func.getFieldNameForChild(0);
        assertNothing(kw_field);
    }

    testNodeToHash() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        hash<auto> h = root.toHash();
        assertEq("module", h.type);
        assertEq(0, h.start_byte);
        assertTrue(h.is_named);
        assertFalse(h.has_error);
    }

    testNodeToSexp() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        string sexp = root.toSexp();
        assertTrue(sexp.find("module") >= 0);
    }

    testNodeDescendantByRange() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        # Find node at byte 4 (the "1")
        *TreeSitterNode desc = root.getDescendantForByteRange(4, 5);
        assertTrue(exists desc);
    }

    testNodeEquality() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root1 = tree.getRootNode();
        TreeSitterNode root2 = tree.getRootNode();
        assertTrue(root1.equals(root2));
    }

    # Cursor tests
    testCursorNavigation() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1\ny = 2");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterCursor cursor = root.getCursor();

        # Navigate to first child
        assertTrue(cursor.gotoFirstChild());
        TreeSitterNode node = cursor.getCurrentNode();
        assertTrue(exists node);

        # Navigate to sibling
        assertTrue(cursor.gotoNextSibling());

        # Navigate back to parent
        assertTrue(cursor.gotoParent());
        assertEq("module", cursor.getCurrentNode().getType());
    }

    testCursorFieldName() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterCursor cursor = root.getCursor();

        cursor.gotoFirstChild();  # function_definition
        cursor.gotoFirstChild();  # first child of function_definition

        # Look for the "name" field
        bool found = False;
        do {
            *string field = cursor.getCurrentFieldName();
            if (field == "name") {
                found = True;
                break;
            }
        } while (cursor.gotoNextSibling());
        # Field name may or may not be present depending on node
    }

    testCursorDepth() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterCursor cursor = root.getCursor();

        assertEq(0, cursor.getCurrentDepth());
        cursor.gotoFirstChild();
        assertEq(1, cursor.getCurrentDepth());
        cursor.gotoFirstChild();
        assertEq(2, cursor.getCurrentDepth());
    }

    testCursorCopy() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterCursor cursor1 = root.getCursor();
        cursor1.gotoFirstChild();

        TreeSitterCursor cursor2 = cursor1.copy();
        assertEq(cursor1.getCurrentNode().getType(), cursor2.getCurrentNode().getType());
    }

    testCursorGotoForByte() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 1\ny = 2");
        TreeSitterNode root = tree.getRootNode();
        TreeSitterCursor cursor = root.getCursor();

        int idx = cursor.gotoFirstChildForByte(6);  # Byte 6 is in "y = 2"
        assertTrue(idx >= 0);
    }

    # Query tests
    testQueryBasic() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass\ndef bar(): pass");
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "(function_definition) @func");
        list<hash<auto>> matches = query.execute(root);
        assertEq(2, matches.size());
    }

    testQueryCaptures() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass\ndef bar(): pass");
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "(function_definition name: (identifier) @name) @func");
        list<hash<auto>> captures = query.captures(root);
        assertTrue(captures.size() >= 2);

        # Check that we have both function names
        list<string> names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                names += cap.node.type;
            }
        }
        assertEq(2, names.size());
    }

    testQueryMultiplePatterns() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("x = 'hello'\ny = 42");
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "
            (string) @string
            (integer) @number
        ");
        list<hash<auto>> captures = query.captures(root);
        assertTrue(captures.size() >= 2);

        assertEq(2, query.getPatternCount());
    }

    testQueryInvalidPattern() {
        assertThrows("TREESITTER-QUERY-ERROR", sub() {
            TreeSitterQuery query("python", "(invalid_node_type_xyz) @x");
        });
    }

    testQueryDisableCapture() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass");
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "(function_definition name: (identifier) @name) @func");
        query.disableCapture("name");

        list<hash<auto>> captures = query.captures(root);
        foreach hash<auto> cap in (captures) {
            assertNeq("name", cap.name);
        }
    }

    testQueryCaptureText() {
        # Verify that captures include the node text
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(): pass\ndef bar(): pass");
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "(function_definition name: (identifier) @name) @func");
        list<hash<auto>> captures = query.captures(root);

        list<string> func_names = ();
        foreach hash<auto> cap in (captures) {
            assertTrue(exists cap.node.text, "capture node should have text field");
            if (cap.name == "name") {
                func_names += cap.node.text;
            }
        }
        assertEq(("foo", "bar"), func_names);

        # Also verify execute() returns text
        list<hash<auto>> matches = query.execute(root);
        assertEq(2, matches.size());
        foreach hash<auto> match in (matches) {
            foreach hash<auto> cap in (match.captures) {
                assertTrue(exists cap.node.text, "execute() capture should have text");
            }
        }
    }

    testQueryByteRange() {
        TreeSitterParser parser("python");
        # Two functions: "def foo(): pass\ndef bar(): pass"
        string source = "def foo(): pass\ndef bar(): pass";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "(function_definition name: (identifier) @name) @func");

        # Restrict to only the first line (bytes 0-15)
        query.setByteRange(0, 16);
        list<hash<auto>> captures = query.captures(root);
        list<string> names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                names += cap.node.text;
            }
        }
        assertEq(1, names.size(), "byte range should limit to first function");
        assertEq("foo", names[0]);

        # Clear range and verify both match again
        query.clearByteRange();
        captures = query.captures(root);
        names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                names += cap.node.text;
            }
        }
        assertEq(2, names.size(), "after clearing byte range, both functions should match");
    }

    testQueryPointRange() {
        TreeSitterParser parser("python");
        string source = "def foo(): pass\ndef bar(): pass";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        TreeSitterQuery query("python", "(function_definition name: (identifier) @name)");

        # Restrict to second line only (row 1)
        query.setPointRange(1, 0, 2, 0);
        list<hash<auto>> captures = query.captures(root);
        list<string> names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                names += cap.node.text;
            }
        }
        assertEq(1, names.size(), "point range should limit to second line");
        assertEq("bar", names[0]);

        # Clear and verify both match
        query.clearPointRange();
        captures = query.captures(root);
        names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                names += cap.node.text;
            }
        }
        assertEq(2, names.size());
    }

    testQueryMaxStartDepth() {
        TreeSitterParser parser("python");
        # Nested function: inner should not match at depth 1
        string source = "def outer():\n    def inner():\n        pass";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Without depth limit, both functions match
        TreeSitterQuery query1("python", "(function_definition name: (identifier) @name)");
        list<hash<auto>> captures = query1.captures(root);
        list<string> all_names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                all_names += cap.node.text;
            }
        }
        assertEq(2, all_names.size(), "without depth limit, both functions should match");

        # With depth limit = 2 (module=0, function_definition=1), only outer matches
        TreeSitterQuery query2("python", "(function_definition name: (identifier) @name)");
        query2.setMaxStartDepth(2);
        captures = query2.captures(root);
        list<string> limited_names = ();
        foreach hash<auto> cap in (captures) {
            if (cap.name == "name") {
                limited_names += cap.node.text;
            }
        }
        assertEq(1, limited_names.size(), "with depth limit, only top-level function should match");
        assertEq("outer", limited_names[0]);
    }

    testQueryPredicateEq() {
        TreeSitterParser parser("python");
        # Two identifiers: "foo" and "bar"
        string source = "foo = 1\nbar = 2";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Match only identifiers that equal "foo"
        TreeSitterQuery query("python", '((identifier) @id (#eq? @id "foo"))');
        list<hash<auto>> captures = query.captures(root);
        assertEq(1, captures.size(), "#eq? should filter to only 'foo'");
        assertEq("foo", captures[0].node.text);
    }

    testQueryPredicateNotEq() {
        TreeSitterParser parser("python");
        string source = "foo = 1\nbar = 2";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Match identifiers that do NOT equal "foo"
        TreeSitterQuery query("python", '((identifier) @id (#not-eq? @id "foo"))');
        list<hash<auto>> captures = query.captures(root);
        # Should match "bar" but not "foo"
        bool found_bar = False;
        bool found_foo = False;
        foreach hash<auto> cap in (captures) {
            if (cap.node.text == "bar") {
                found_bar = True;
            }
            if (cap.node.text == "foo") {
                found_foo = True;
            }
        }
        assertTrue(found_bar, "#not-eq? should include 'bar'");
        assertFalse(found_foo, "#not-eq? should exclude 'foo'");
    }

    testQueryPredicateMatch() {
        TreeSitterParser parser("python");
        # Identifiers: "_private", "public_func", "__dunder__"
        string source = "_private = 1\npublic_func = 2\n__dunder__ = 3";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Match only identifiers starting with underscore
        TreeSitterQuery query("python", '((identifier) @id (#match? @id "^_"))');
        list<hash<auto>> captures = query.captures(root);
        foreach hash<auto> cap in (captures) {
            assertTrue(cap.node.text =~ /^_/, sprintf("#match? filtered id '%s' should start with _", cap.node.text));
        }
        assertTrue(captures.size() >= 2, "should match _private and __dunder__");
    }

    testQueryPredicateNotMatch() {
        TreeSitterParser parser("python");
        string source = "_private = 1\npublic_func = 2\n__dunder__ = 3";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Match identifiers NOT starting with underscore
        TreeSitterQuery query("python", '((identifier) @id (#not-match? @id "^_"))');
        list<hash<auto>> captures = query.captures(root);
        foreach hash<auto> cap in (captures) {
            assertFalse(cap.node.text =~ /^_/,
                sprintf("#not-match? should exclude ids starting with _, got '%s'", cap.node.text));
        }
        # Should include "public_func" but not "_private" or "__dunder__"
        bool found_public = False;
        foreach hash<auto> cap in (captures) {
            if (cap.node.text == "public_func") {
                found_public = True;
            }
        }
        assertTrue(found_public, "#not-match? should include 'public_func'");
    }

    testQueryPredicateAnyOf() {
        TreeSitterParser parser("python");
        string source = "alpha = 1\nbeta = 2\ngamma = 3";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Match identifiers that are one of "alpha" or "gamma"
        TreeSitterQuery query("python", '((identifier) @id (#any-of? @id "alpha" "gamma"))');
        list<hash<auto>> captures = query.captures(root);
        foreach hash<auto> cap in (captures) {
            assertTrue(cap.node.text == "alpha" || cap.node.text == "gamma",
                sprintf("#any-of? should only match alpha/gamma, got '%s'", cap.node.text));
        }
        assertEq(2, captures.size(), "should match alpha and gamma");
    }

    testQueryPredicateNotAnyOf() {
        TreeSitterParser parser("python");
        string source = "alpha = 1\nbeta = 2\ngamma = 3";
        TreeSitterTree tree = parser.parse(source);
        TreeSitterNode root = tree.getRootNode();

        # Match identifiers that are NOT "alpha" or "gamma"
        TreeSitterQuery query("python", '((identifier) @id (#not-any-of? @id "alpha" "gamma"))');
        list<hash<auto>> captures = query.captures(root);
        foreach hash<auto> cap in (captures) {
            assertNeq("alpha", cap.node.text);
            assertNeq("gamma", cap.node.text);
        }
        # Should contain "beta" (and nothing else that's alpha/gamma)
        bool found_beta = False;
        foreach hash<auto> cap in (captures) {
            if (cap.node.text == "beta") {
                found_beta = True;
            }
        }
        assertTrue(found_beta, "#not-any-of? should include 'beta'");
    }

    # Incremental parsing tests
    testIncrementalParsing() {
        TreeSitterParser parser("python");

        string code1 = "def foo(): pass";
        TreeSitterTree tree1 = parser.parse(code1);

        # Edit: change "foo" to "bar"
        tree1.edit(4, 7, 7, 0, 4, 0, 7, 0, 7);

        string code2 = "def bar(): pass";
        TreeSitterTree tree2 = parser.parseIncremental(code2, tree1);

        TreeSitterNode root = tree2.getRootNode();
        assertEq("module", root.getType());
        assertFalse(root.hasError());
    }

    # Error handling tests
    testParseWithErrors() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def incomplete(");
        TreeSitterNode root = tree.getRootNode();
        assertTrue(root.hasError());
    }

    testMissingNodes() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("def foo(");
        TreeSitterNode root = tree.getRootNode();

        # Check that tree has error flag for incomplete code
        assertTrue(root.hasError());  # Tree should have error
    }

    # Highlight query tests
    testHighlightQueryValidLanguages() {
        # Every language in the query_lang_map should return a non-empty string
        list<string> langs = ("python", "java", "json", "yaml", "javascript", "kotlin", "typescript", "sql", "markdown");
        foreach string lang in (langs) {
            string query = TreeSitterParser::getHighlightQuery(lang);
            assertTrue(query.length() > 0, sprintf("query for %s should be non-empty", lang));
            # All queries should contain at least one capture (@-prefixed name)
            assertTrue(query.find("@") >= 0, sprintf("query for %s should contain captures", lang));
        }
    }

    testHighlightQueryAliases() {
        # Aliases should return the same query as the canonical name
        string js_query = TreeSitterParser::getHighlightQuery("js");
        string javascript_query = TreeSitterParser::getHighlightQuery("javascript");
        assertEq(js_query, javascript_query, "js and javascript should return the same query");

        string kt_query = TreeSitterParser::getHighlightQuery("kt");
        string kotlin_query = TreeSitterParser::getHighlightQuery("kotlin");
        assertEq(kt_query, kotlin_query, "kt and kotlin should return the same query");

        string ts_query = TreeSitterParser::getHighlightQuery("ts");
        string typescript_query = TreeSitterParser::getHighlightQuery("typescript");
        assertEq(ts_query, typescript_query, "ts and typescript should return the same query");

        # tsx maps to typescript queries
        string tsx_query = TreeSitterParser::getHighlightQuery("tsx");
        assertEq(tsx_query, typescript_query, "tsx and typescript should return the same query");
    }

    testHighlightQueryInvalid() {
        # Unsupported language should throw
        assertThrows("TREESITTER-QUERY-ERROR", sub() {
            TreeSitterParser::getHighlightQuery("nonexistent");
        });

        # Qore is a supported parser language but not in the highlight query map
        assertThrows("TREESITTER-QUERY-ERROR", sub() {
            TreeSitterParser::getHighlightQuery("qore");
        });
    }

    testHighlightQueryParseable() {
        # Every bundled query should be parseable by the tree-sitter query engine
        # Note: some upstream queries use predicates (#match?, #eq?) that may cause
        # parse errors; such queries are still valid .scm content
        hash<string, string> lang_parser_map = {
            "python": "python",
            "java": "java",
            "json": "json",
            "yaml": "yaml",
            "javascript": "javascript",
            "kotlin": "kotlin",
            "typescript": "typescript",
            "sql": "sql",
            "markdown": "markdown",
        };

        foreach hash<auto> entry in (lang_parser_map.pairIterator()) {
            string query_text = TreeSitterParser::getHighlightQuery(entry.key);
            try {
                TreeSitterQuery query(entry.value, query_text);
                assertTrue(query.getPatternCount() > 0,
                    sprintf("%s highlight query should have patterns", entry.key));
            } catch (hash<ExceptionInfo> ex) {
                # Upstream queries with predicates may not parse — verify it's a query
                # error (not a missing file or other error)
                assertEq("TREESITTER-QUERY-ERROR", ex.err,
                    sprintf("%s query should only fail due to parse error", entry.key));
            }
        }
    }

    testHighlightQueryCaching() {
        # Calling getHighlightQuery twice should return identical results (cache hit)
        string q1 = TreeSitterParser::getHighlightQuery("python");
        string q2 = TreeSitterParser::getHighlightQuery("python");
        assertEq(q1, q2, "cached query should be identical");
    }

    testGeneralizedQueryAPI() {
        # Test getQuery() with different query types
        # JavaScript has locals.scm
        string locals = TreeSitterParser::getQuery("javascript", "locals");
        assertTrue(locals.length() > 0, "javascript locals query should be non-empty");

        # JavaScript has injections.scm
        string injections = TreeSitterParser::getQuery("javascript", "injections");
        assertTrue(injections.length() > 0, "javascript injections query should be non-empty");

        # getHighlightQuery should return the same as getQuery with "highlights"
        string hl1 = TreeSitterParser::getHighlightQuery("python");
        string hl2 = TreeSitterParser::getQuery("python", "highlights");
        assertEq(hl1, hl2, "getHighlightQuery and getQuery('highlights') should match");

        # Nonexistent query type should throw
        assertThrows("TREESITTER-QUERY-ERROR", \TreeSitterParser::getQuery(), ("python", "nonexistent_type"));

        # Nonexistent language should throw
        assertThrows("TREESITTER-QUERY-ERROR", \TreeSitterParser::getQuery(), ("nonexistent", "highlights"));

        # SQL has indents.scm
        string indents = TreeSitterParser::getQuery("sql", "indents");
        assertTrue(indents.length() > 0, "sql indents query should be non-empty");

        # Markdown has injections.scm
        string md_inj = TreeSitterParser::getQuery("markdown", "injections");
        assertTrue(md_inj.length() > 0, "markdown injections query should be non-empty");

        # Aliases should work
        string md_hl = TreeSitterParser::getQuery("md", "highlights");
        string markdown_hl = TreeSitterParser::getQuery("markdown", "highlights");
        assertEq(md_hl, markdown_hl, "md and markdown aliases should return same query");
    }

    testSQLHighlightQuery() {
        string query_text = TreeSitterParser::getHighlightQuery("sql");
        assertTrue(query_text.length() > 0, "SQL highlight query should be non-empty");
        assertTrue(query_text.find("@") >= 0, "SQL highlight query should contain captures");

        # Parse and run the query
        try {
            TreeSitterQuery query("sql", query_text);
            assertTrue(query.getPatternCount() > 0, "SQL highlight query should have patterns");

            # Run against actual SQL
            TreeSitterParser parser("sql");
            TreeSitterTree tree = parser.parse("SELECT id, name FROM users WHERE id = 1");
            list<hash<auto>> captures = query.captures(tree.getRootNode());
            assertTrue(captures.size() > 0, "SQL highlight query should produce captures");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TREESITTER-QUERY-ERROR", ex.err);
        }
    }

    testMarkdownHighlightQuery() {
        string query_text = TreeSitterParser::getHighlightQuery("markdown");
        assertTrue(query_text.length() > 0, "Markdown highlight query should be non-empty");

        try {
            TreeSitterQuery query("markdown", query_text);
            assertTrue(query.getPatternCount() > 0, "Markdown highlight query should have patterns");

            TreeSitterParser parser("markdown");
            TreeSitterTree tree = parser.parse("# Hello\n\n**bold** text");
            list<hash<auto>> captures = query.captures(tree.getRootNode());
            assertTrue(captures.size() > 0, "Markdown highlight query should produce captures");
        } catch (hash<ExceptionInfo> ex) {
            assertEq("TREESITTER-QUERY-ERROR", ex.err);
        }
    }

    # Edge cases and corner cases
    testEmptySource() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("");
        TreeSitterNode root = tree.getRootNode();
        assertEq("module", root.getType());
        assertEq(0, root.getNamedChildCount());
    }

    testUnicodeSource() {
        TreeSitterParser parser("python");
        TreeSitterTree tree = parser.parse("# Héllo Wörld\nx = 'привет'");
        TreeSitterNode root = tree.getRootNode();
        assertFalse(root.hasError());
    }

    testLargeSource() {
        TreeSitterParser parser("python");

        # Generate large source
        string code = "";
        for (int i = 0; i < 100; i++) {
            code += sprintf("def func%d():\n    pass\n\n", i);
        }

        TreeSitterTree tree = parser.parse(code);
        TreeSitterNode root = tree.getRootNode();
        assertEq(100, root.getNamedChildCount());
    }

    testDeeplyNested() {
        TreeSitterParser parser("python");
        # Create deeply nested expression
        string code = "x = " + strmul("(", 50) + "1" + strmul(")", 50);
        TreeSitterTree tree = parser.parse(code);
        TreeSitterNode root = tree.getRootNode();
        assertTrue(exists root);
    }
}
